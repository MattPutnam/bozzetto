{
  "name": "bozzetto",
  "version": "0.1.0",
  "description": "Seeded placeholder images as tiny SVGs: landscapes, art, people, animals, food and still lifes, drawn from a handful of shapes, in any palette.",
  "keywords": [
    "avatar",
    "data-uri",
    "fixtures",
    "generative",
    "illustration",
    "mock",
    "placeholder",
    "placeholder-image",
    "react",
    "seeded",
    "svg",
    "vue",
    "web-component"
  ],
  "homepage": "https://mattputnam.github.io/bozzetto/",
  "bugs": {
    "url": "https://github.com/MattPutnam/bozzetto/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MattPutnam/bozzetto.git"
  },
  "license": "MIT",
  "author": "Matt Putnam",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "bozzetto": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./node": {
      "import": {
        "types": "./dist/node.d.ts",
        "default": "./dist/node.js"
      },
      "require": {
        "types": "./dist/node.d.cts",
        "default": "./dist/node.cjs"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/react.d.ts",
        "default": "./dist/react.js"
      },
      "require": {
        "types": "./dist/react.d.cts",
        "default": "./dist/react.cjs"
      }
    },
    "./vue": {
      "import": {
        "types": "./dist/vue.d.ts",
        "default": "./dist/vue.js"
      },
      "require": {
        "types": "./dist/vue.d.cts",
        "default": "./dist/vue.cjs"
      }
    },
    "./element": {
      "import": {
        "types": "./dist/element.d.ts",
        "default": "./dist/element.js"
      },
      "require": {
        "types": "./dist/element.d.cts",
        "default": "./dist/element.cjs"
      }
    }
  },
  "files": [
    "dist",
    "!dist/bin.cjs",
    "!dist/bin.cjs.map",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "./dist/element.js",
    "./dist/element.cjs"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit -p .",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test",
    "dev": "vite demo",
    "pages": "node scripts/pages.mjs",
    "gallery": "npm run build && node scripts/gallery.mjs",
    "docs:examples": "vite-node docs/scripts/examples.ts",
    "docs:api": "typedoc --options docs/typedoc.json",
    "docs:dev": "npm run docs:examples && npm run docs:api && vitepress dev docs",
    "docs:build": "npm run docs:examples && npm run docs:api && vitepress build docs && npm run docs:demo",
    "docs:demo": "vite build demo --base /bozzetto/demo/ --outDir ../docs/.vitepress/dist/demo --emptyOutDir",
    "docs:preview": "vitepress preview docs",
    "release": "npm run check && npm run build && npm publish"
  },
  "peerDependencies": {
    "@resvg/resvg-js": "^2.6.0",
    "react": ">=16.8",
    "vue": "^3.3"
  },
  "peerDependenciesMeta": {
    "@resvg/resvg-js": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "esbuild": "^0.27.7",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.10.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsup": "^8.3.5",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.14.1",
    "typedoc-vitepress-theme": "^1.1.4",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^5.4.11",
    "vite-node": "^2.1.9",
    "vitepress": "^1.6.4",
    "vitest": "^2.1.8",
    "vue": "^3.5.46"
  },
  "engines": {
    "node": ">=18.3"
  }
}
