{
  "name": "bozzetto",
  "version": "0.1.0",
  "description": "Seeded placeholder images as tiny SVGs: landscapes, modern-art homages, faces and animals, drawn from a handful of shapes.",
  "keywords": [
    "placeholder",
    "placeholder-image",
    "svg",
    "data-uri",
    "generative",
    "seeded",
    "mock",
    "fixtures",
    "avatar",
    "illustration"
  ],
  "homepage": "https://github.com/MattPutnam/bozzetto#readme",
  "bugs": {
    "url": "https://github.com/MattPutnam/bozzetto/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MattPutnam/bozzetto.git"
  },
  "license": "MIT",
  "author": "Matt Putnam",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit -p .",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test",
    "dev": "vite demo",
    "gallery": "npm run build && node scripts/gallery.mjs",
    "release": "npm run check && npm run build && npm publish"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
